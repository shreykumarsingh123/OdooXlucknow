# Copy to .env and fill in. Placeholders only: never put real values in this file.
# Assumes the default stack. Update if docs/DECISIONS.md changes it.

DEBUG=true
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=odooxlko
DB_USER=odooxlko
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
TIME_ZONE=Asia/Kolkata

# Email. Without these, messages are written to backend/sent_emails/ instead of being sent.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=replace-me
# EMAIL_HOST_PASSWORD=replace-me
# DEFAULT_FROM_EMAIL=Brightloop Billing <billing@example.com>

# Production, with DEBUG=false: SECRET_KEY must be 50 or more random characters.
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Frontend, only when the API is on another domain. Set at build time.
# VITE_API_BASE_URL=https://api.your-domain.example/api

# Online invoice payment. Without a key, the Pay online button stays hidden.
# STRIPE_SECRET_KEY=replace-me
# STRIPE_WEBHOOK_SECRET=replace-me
# STRIPE_CURRENCY=inr

# Overdue reminders by SMS. Without all four, reminders go by email only.
# TWILIO_ACCOUNT_SID=replace-me
# TWILIO_API_KEY_SID=replace-me
# TWILIO_API_KEY_SECRET=replace-me
# TWILIO_FROM_NUMBER=+10000000000
# REMINDER_INTERVAL_DAYS=3
# REMINDER_MAX_COUNT=3

# Google sign-in. Without it, the Google button stays hidden.
# GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
